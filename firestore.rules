rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Eventos - leitura autenticada, escrita pública (para tracking)
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create: if true; // Permitir tracking público
    }
    
    // Users - leitura autenticada, escrita pública (para leads/remarketing)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if true; // Permitir atualizar leads publicamente
    }
    
    // Transactions - apenas leitura autenticada
    match /transactions/{transactionId} {
      allow read: if request.auth != null;
      allow write: if false; // Somente via webhook
    }
    
    // Cart abandons - apenas leitura autenticada
    match /cart_abandons/{abandonId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
