rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Eventos - leitura autenticada, escrita pública (para tracking)
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create: if true; // Permitir tracking público
    }
    
    // Users - leitura autenticada, escrita pública (para leads/remarketing)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if true; // Permitir atualizar leads publicamente
    }
    
    // Transactions - controle granular
    match /transactions/{transactionId} {
      allow read: if request.auth != null;
      allow create, update: if false; // Apenas webhook
      allow delete: if true; // Permitir limpar banco
    }
    
    // Cart abandons
    match /cart_abandons/{abandonId} {
      allow read: if request.auth != null;
      allow create, update: if false;
      allow delete: if true; // Permitir limpar banco
    }
    
    // Webhook errors
    match /webhook_errors/{errorId} {
      allow read: if request.auth != null;
      allow create, update: if false;
      allow delete: if true;
    }
  }
}
